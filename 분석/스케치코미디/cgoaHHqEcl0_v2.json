  "subs": [
    {
      "t": 0.0,
      "text": "형님이 소원 들어줄게",
      "kind": "line"
    },
    {
      "t": 1.38,
      "text": "소원이요?",
      "kind": "line"
    },
    {
      "t": 2.25,
      "text": "네가 원하는 거 다",
      "kind": "line"
    },
    {
      "t": 3.57,
      "text": "원하는 거 다요?",
      "kind": "line"
    },
    {
      "t": 5.64,
      "text": "형아",
      "kind": "line"
    },
    {
      "t": 5.89,
      "text": "나 불렀냐?",
      "kind": "line"
    },
    {
      "t": 6.39,
      "text": "삼촌 우리 집 좀 그만 와",
      "kind": "line"
    },
    {
      "t": 8.34,
      "text": "제가 안 좋은 것만 배우잖아",
      "kind": "line"
    },
    {
      "t": 10.02,
      "text": "왜 나한테...",
      "kind": "line"
    },
    {
      "t": 11.43,
      "text": "뭐가 지명이니?",
      "kind": "line"
    },
    {
      "t": 13.8,
      "text": "저 사람이요?",
      "kind": "line"
    },
    {
      "t": 14.73,
      "text": "도로 가시라고 할까?",
      "kind": "line"
    },
    {
      "t": 16.11,
      "text": "아니, 나 인서울 할...",
      "kind": "line"
    },
    {
      "t": 17.61,
      "text": "손 안 떼고 싶지 않을 거야",
      "kind": "line"
    },
    {
      "t": 19.83,
      "text": "하... 안 되는데",
      "kind": "line"
    },
    {
