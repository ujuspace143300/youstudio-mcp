  "subs_asr": [
    {
      "t": 0.0,
      "text": "님이 소원 들어줄게 소원이야"
    },
    {
      "t": 2.2,
      "text": "니가 원하는 거 다 원하는 거"
    },
    {
      "t": 4.1,
      "text": "다 해요. 하나 나 불렀냐? 삼촌은"
    },
    {
      "t": 6.9,
      "text": "우리 집 좀 그만. 와. 제가"
    },
    {
      "t": 8.6,
      "text": "안 좋은 것만 배우잖아. 왜"
    },
    {
      "t": 10.2,
      "text": "나한테 그래? 네가 지명이니"
    },
    {
      "t": 13.8,
      "text": "저 사람이야. 도로 가시라고"
    },
    {
      "t": 15.4,
      "text": "할까? 아니, 나 인서울 하려면"
    },
    {
      "t": 17.6,
      "text": "손 한 번씩 잡을 거야. 아"
    },
    {
      "t": 19.8,
      "text": "안 되는데. 똑똑! 아, 여기에"
    },
    {
      "t": 24.0,
      "text": "과일 좀 드시면서 하세요. 감사합니다"
    },
    {
      "t": 26.7,
      "text": "그래. 무슨 목표야? 네가 원하는"
    },
    {
      "t": 30.0,
      "text": "그런 것들 있잖아. 있는 것"
    },
    {
      "t": 31.7,
      "text": "같긴 한데 지명이가 해요. 네"
    },
    {
      "t": 34.3,
      "text": "솔직히 지명이 얘는 답이 없어요"
    },
    {
      "t": 37.0,
      "text": "아, 개인 방송이라도 시켜야"
    }
  ],
