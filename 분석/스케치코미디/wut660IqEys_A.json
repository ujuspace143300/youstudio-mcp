  "subs_asr": [
    {
      "t": 0.2,
      "text": "아 아 오빠 오빠"
    },
    {
      "t": 3.0,
      "text": "오빠"
    },
    {
      "t": 4.4,
      "text": "아 아 아 아 나 친구들이랑"
    },
    {
      "t": 5.7,
      "text": "노래방 와서 내가 소리가 잘"
    },
    {
      "t": 7.6,
      "text": "안 들려서 미안해. 자기야 누구야"
    },
    {
      "t": 10.0,
      "text": "장인어른이야? 아니, 아빠 이거"
    },
    {
      "t": 12.4,
      "text": "친구가 장난치는 거야? 알겠습니다"
    },
    {
      "t": 15.0,
      "text": "오정식 씨 걱정하지 마세요. 아"
    },
    {
      "t": 18.0,
      "text": "뭐해? 아, 왜"
    },
    {
      "t": 20.2,
      "text": "아, 고등학교 때 다 이렇게"
    },
    {
      "t": 21.3,
      "text": "놀아줄 알았어. 아, 난 엄청"
    },
    {
      "t": 23.3,
      "text": "약한 건데. 내 층 더 심해준"
    },
    {
      "t": 25.3,
      "text": "아, 괜찮아"
    },
    {
      "t": 26.6,
      "text": "어, 잘 둘러댔어. 아, 아니야"
    },
    {
      "t": 28.7,
      "text": "아빠 이거 친구 아니고 그 옆방"
    },
    {
      "t": 30.1,
      "text": "소리 아니야 아빠 미안해 아니야"
    },
    {
      "t": 32.8,
      "text": "야, 사과해. 빨리"
    }
  ],
