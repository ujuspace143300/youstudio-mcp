  "subs_asr": [
    {
      "t": 0.0,
      "text": "열고 계시는 거예요. 유선 마사나"
    },
    {
      "t": 1.5,
      "text": "할 것 같아요. 내일 썸녀랑"
    },
    {
      "t": 4.0,
      "text": "약속이 있는데 옷 괜찮은지 봐주세요"
    },
    {
      "t": 7.0,
      "text": "아"
    },
    {
      "t": 8.2,
      "text": "괜찮아요. 아끼는 옷들로 골라본건데"
    },
    {
      "t": 11.7,
      "text": "컨셉이죠. 에이, 컨셉이 겠죠"
    },
    {
      "t": 13.8,
      "text": "솔직히 컨셉이 시죠. 네. 봄"
    },
    {
      "t": 15.9,
      "text": "맞이 컨셉으로"
    },
    {
      "t": 17.3,
      "text": "썸녀인데 어떻게 첫 데이트인가요"
    },
    {
      "t": 19.4,
      "text": "상황상 사실 썸은 아니고 내일"
    },
    {
      "t": 21.8,
      "text": "처음 보는데 연락 느낌이 좋아서"
    },
    {
      "t": 23.6,
      "text": "썸녀라고 했습니다. 하하하하하하하하하하하하하하하하하하하"
    },
    {
      "t": 26.9,
      "text": "삐끼"
    },
    {
      "t": 28.1,
      "text": "어두운 셔츠를 입어봤어요. 괜찮나요"
    },
    {
      "t": 30.1,
      "text": "네가 더 태우세요? 저게 옷이"
    },
    {
      "t": 31.5,
      "text": "지금 뭐 어떻게 되어 있는거예요"
    },
    {
      "t": 33.4,
      "text": "저 가슴에 모자이크는 왜"
    },
    {
      "t": 35.8,
      "text": "흰셔츠 있어요? 아 자꾸 이런"
    },
    {
      "t": 37.6,
      "text": "건 어디서 들고 오시는 거지"
    },
    {
      "t": 39.0,
      "text": "스킵. 뭐예요? 이런 건 아무도"
    }
  ],
