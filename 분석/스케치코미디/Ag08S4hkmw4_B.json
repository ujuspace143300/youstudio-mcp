  "subs": [
    {
      "t": 0.0,
      "text": "매달고 계시는 거예요.",
      "kind": "line"
    },
    {
      "t": 0.87,
      "text": "유선방송 날 거 같아요.",
      "kind": "line"
    },
    {
      "t": 3.3,
      "text": "(꺄악)",
      "kind": "line"
    },
    {
      "t": 3.55,
      "text": "내일 썸녀랑 약속 있는데",
      "kind": "line"
    },
    {
      "t": 4.95,
      "text": "옷 괜찮은지 봐주세요.",
      "kind": "line"
    },
    {
      "t": 8.19,
      "text": "(한숨)",
      "kind": "line"
    },
    {
      "t": 8.44,
      "text": "괜찮나요?",
      "kind": "line"
    },
    {
      "t": 9.03,
      "text": "아끼는 옷들로 골라본 건데",
      "kind": "line"
    },
    {
      "t": 11.67,
      "text": "(심각)",
      "kind": "line"
    },
    {
      "t": 11.92,
      "text": "컨셉이죠?",
      "kind": "line"
    },
    {
      "t": 12.63,
      "text": "에이, 컨셉이겠죠.",
      "kind": "line"
    },
    {
      "t": 13.8,
      "text": "솔직히 컨셉이시죠?",
      "kind": "line"
    },
    {
      "t": 15.33,
      "text": "네, 봄맞이 컨셉으로",
      "kind": "line"
    },
    {
      "t": 17.31,
      "text": "응?",
      "kind": "line"
    },
    {
      "t": 17.56,
      "text": "썸녀인데 어떻게",
      "kind": "line"
    },
    {
      "t": 18.36,
      "text": "첫 데이트인가요?",
      "kind": "line"
    },
    {
      "t": 19.44,
      "text": "상상",
      "kind": "line"
    },
    {
      "t": 20.28,
      "text": "사실 썸은 아니고",
      "kind": "line"
    },
    {
      "t": 21.6,
      "text": "내일 처음 보는데",
      "kind": "line"
    },
    {
      "t": 22.38,
      "text": "연락 느낌이 좋아서",
      "kind": "line"
    },
    {
      "t": 23.55,
      "text": "썸녀라고 했습니다! ㅎㅎ",
      "kind": "line"
    },
    {
      "t": 24.3,
      "text": "(빵터짐)",
      "kind": "line"
    },
    {
      "t": 25.5,
      "text": "(헛웃음)",
      "kind": "line"
    },
    {
      "t": 28.05,
      "text": "어두운 셔츠 입어봤어요.",
      "kind": "line"
    },
    {
      "t": 29.16,
      "text": "괜찮나요?",
      "kind": "line"
    },
    {
      "t": 30.39,
      "text": "이것도 태우세요.",
      "kind": "line"
    },
    {
      "t": 30.96,
      "text": "저게 옷이 지금",
      "kind": "line"
    },
    {
      "t": 31.86,
      "text": "뭐 어떻게 되어 있는 거예요?",
      "kind": "line"
    },
    {
      "t": 33.42,
      "text": "저 가슴에 모자이크는 왜...",
      "kind": "line"
    },
    {
      "t": 35.76,
      "text": "흰 셔츠 있어요!",
      "kind": "line"
    },
    {
      "t": 37.14,
      "text": "자꾸 이런 건",
      "kind": "line"
    },
    {
      "t": 37.74,
      "text": "어디서 들고 오시는 거지?",
      "kind": "line"
    },
    {
      "t": 39.48,
      "text": "이게 뭐예요?",
      "kind": "line"
    },
    {
      "t": 40.17,
      "text": "이런 건 아무도 흰 셔츠라고",
      "kind": "line"
    },
    {
      "t": 41.58,
      "text": "부르지 않아요!",
      "kind": "line"
    }
  ],
