  "subs": [
    {
      "t": 0.32,
      "text": "휴리빽!",
      "kind": "line"
    },
    {
      "t": 3.08,
      "text": "어떻게 알았어~",
      "kind": "line"
    },
    {
      "t": 3.33,
      "text": "(신나게 탬버린 흔드는 중)",
      "kind": "line"
    },
    {
      "t": 5.0,
      "text": "(엉덩이가 큰 그녀 부르는 중)",
      "kind": "line"
    },
    {
      "t": 8.0,
      "text": "렛츠 고!",
      "kind": "line"
    },
    {
      "t": 10.73,
      "text": "(슬금슬금 다가오는...)",
      "kind": "line"
    },
    {
      "t": 11.5,
      "text": "(음흉하게 밀착)",
      "kind": "line"
    },
    {
      "t": 15.5,
      "text": "(식겁)",
      "kind": "line"
    },
    {
      "t": 15.75,
      "text": "야야야...",
      "kind": "line"
    },
    {
      "t": 16.0,
      "text": "야",
      "kind": "line"
    },
    {
      "t": 18.11,
      "text": "뭐 해 병신아",
      "kind": "line"
    },
    {
      "t": 19.52,
      "text": "왜? 야 나 같이",
      "kind": "line"
    },
    {
      "t": 20.36,
      "text": "섹시 댄스 춘 건데",
      "kind": "line"
    },
    {
      "t": 22.01,
      "text": "아 씨발 사람 표정을",
      "kind": "line"
    },
    {
      "t": 23.09,
      "text": "보고 해야 될 거 아니야",
      "kind": "line"
    },
    {
      "t": 24.71,
      "text": "아니 왜 그러냐 진짜 씨발",
      "kind": "line"
    },
    {
      "t": 25.94,
      "text": "야 그냥 꺼져 너",
      "kind": "line"
    },
    {
      "t": 27.2,
      "text": "아 씨...",
      "kind": "line"
    },
    {
      "t": 27.83,
      "text": "꺼지려면 지들이 꺼지는 거지",
      "kind": "line"
    },
    {
      "t": 29.15,
      "text": "내가 알아본 건데...",
      "kind": "line"
    },
    {
      "t": 30.56,
      "text": "어? 씨 내가 맘만...",
      "kind": "line"
    },
    {
      "t": 32.45,
      "text": "(친구 감싸는 중)",
      "kind": "line"
    },
    {
      "t": 32.7,
      "text": "아 씨발 뭐야 이거",
      "kind": "line"
    },
    {
      "t": 36.65,
      "text": "(옷 벗어서 덮어주려는데)",
      "kind": "line"
    },
    {
      "t": 36.9,
      "text": "아...",
      "kind": "line"
    },
    {
      "t": 38.48,
      "text": "(찰싹!)",
      "kind": "line"
    },
    {
      "t": 38.73,
