  "subs_asr": [
    {
      "t": 0.0,
      "text": "님 벨트 빼세요. 빨리 왜 다"
    },
    {
      "t": 2.2,
      "text": "된 밥에 벨트를 뿌리세요? 그냥"
    },
    {
      "t": 4.7,
      "text": "무채색 옷 없어요. 아니 회색"
    },
    {
      "t": 6.5,
      "text": "없나요? 그레이가 제일 무난하면서"
    },
    {
      "t": 8.7,
      "text": "예쁜데 그레이색이야아 그레이"
    },
    {
      "t": 11.7,
      "text": "하나 있긴 한데 그건 이상하게"
    },
    {
      "t": 13.4,
      "text": "손이 안 가서 그거 그거 그거"
    },
    {
      "t": 14.9,
      "text": "들고오잖아. 그거 그거 그거"
    },
    {
      "t": 16.0,
      "text": "그거 빨리 들어봐요. 너무 심심한"
    },
    {
      "t": 19.1,
      "text": "거 같은데. 와 대박! 이제"
    },
    {
      "t": 21.0,
      "text": "상의는 절대 건들지 마세요. 와"
    },
    {
      "t": 22.6,
      "text": "그레이가 사람 살렸네. 아 그리고"
    },
    {
      "t": 24.5,
      "text": "주간 좀 버려요. 자 여기서"
    },
    {
      "t": 26.1,
      "text": "바지만 긴바지로 바꿔봅시다. 작성자님"
    },
    {
      "t": 28.3,
      "text": "이제 괜찮나요? 진짜 사람 열받으라고"
    },
    {
      "t": 32.3,
      "text": "이러는 거예요. 청바지 아직"
    },
    {
      "t": 34.8,
      "text": "안 돼 안 돼. 저 바지를 혹시"
    },
    {
      "t": 36.3,
      "text": "썸녀가 사준 건가요? 제발 그냥"
    },
    {
      "t": 38.5,
      "text": "검은긴바지 채. 이게 뭐고 미친"
    }
  ],
