  "subs": [
    {
      "t": 0.0,
      "text": "님 벨트 빼세요",
      "kind": "line"
    },
    {
      "t": 1.35,
      "text": "빨리",
      "kind": "line"
    },
    {
      "t": 1.74,
      "text": "왜 다 된 밥에",
      "kind": "line"
    },
    {
      "t": 2.76,
      "text": "벨트를 뿌리세요오",
      "kind": "line"
    },
    {
      "t": 4.47,
      "text": "그냥 무채색 옷 없어요?",
      "kind": "line"
    },
    {
      "t": 5.79,
      "text": "아니 회색 없나요?",
      "kind": "line"
    },
    {
      "t": 7.14,
      "text": "그레이가 제일",
      "kind": "line"
    },
    {
      "t": 8.1,
      "text": "무난하면서 이쁜데",
      "kind": "line"
    },
    {
      "t": 9.24,
      "text": "그레이색이야",
      "kind": "line"
    },
    {
      "t": 9.49,
      "text": "아... 그레이 하나",
      "kind": "line"
    },
    {
      "t": 11.88,
      "text": "있긴 한데...",
      "kind": "line"
    },
    {
      "t": 12.69,
      "text": "그건 이상하게",
      "kind": "line"
    },
    {
      "t": 13.38,
      "text": "손이 안 가서;;",
      "kind": "line"
    },
    {
      "t": 14.04,
      "text": "그거임 그거임!",
      "kind": "line"
    },
    {
      "t": 14.67,
      "text": "그거 들고 오셈!",
      "kind": "line"
    },
    {
      "t": 15.27,
      "text": "그거 그거 그거!",
      "kind": "line"
    },
    {
      "t": 16.02,
      "text": "그거 빨리 입어봐요",
      "kind": "line"
    },
    {
      "t": 18.39,
      "text": "너무 심심한 거 같은데...",
      "kind": "line"
    },
    {
      "t": 19.86,
      "text": "와 대박!",
      "kind": "line"
    },
    {
      "t": 20.76,
      "text": "이제 상의는",
      "kind": "line"
    },
    {
      "t": 21.3,
      "text": "절대 건들지 마세요",
      "kind": "line"
    },
    {
      "t": 22.26,
      "text": "와 그레이가 사람 살렸네",
      "kind": "line"
    },
    {
      "t": 23.91,
      "text": "아 그리고 주관 좀 버려요",
      "kind": "line"
    },
    {
      "t": 25.29,
      "text": "자 여기서 바지만",
      "kind": "line"
    },
    {
      "t": 26.55,
      "text": "긴바지로 바꿔봅시다",
      "kind": "line"
    },
    {
      "t": 27.57,
      "text": "작성자님, 이제...",
      "kind": "line"
    },
    {
      "t": 28.98,
      "text": "괜찮나요?",
      "kind": "line"
    },
    {
      "t": 31.11,
      "text": "(말을 잇지 못함...)",
      "kind": "line"
    },
    {
      "t": 31.36,
      "text": "진짜 사람 열받으라고",
      "kind": "line"
    },
    {
      "t": 32.34,
      "text": "이러는 거예요?",
      "kind": "line"
    },
    {
      "t": 33.93,
      "text": "(빵 터짐 ㅋㅋㅋ)",
      "kind": "line"
    },
    {
      "t": 34.18,
      "text": "저 바지 아직 안 버렸네",
      "kind": "line"
    },
    {
      "t": 35.58,
      "text": "저 바지를 혹시",
      "kind": "line"
    },
    {
      "t": 36.33,
      "text": "썸녀가 사준 건가요?",
      "kind": "line"
    },
    {
      "t": 37.68,
      "text": "제발 그냥",
      "kind": "line"
    },
    {
      "t": 38.46,
      "text": "검은 긴바지...",
      "kind": "line"
    },
    {
      "t": 42.0,
      "text": "(새로운 사진 확인)",
      "kind": "line"
    },
    {
      "t": 42.25,
      "text": "이건 뭐야?",
      "kind": "line"
    },
    {
      "t": 42.99,
      "text": "미친 진짜ㅋㅋㅋ",
      "kind": "line"
    },
    {
      "t": 45.0,
      "text": "캬~",
      "kind": "line"
    }
  ],
