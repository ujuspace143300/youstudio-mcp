  "subs_before_sync": [
    {
      "t": 0.29,
      "text": "아니 6개월 동안",
      "kind": "line"
    },
    {
      "t": 1.04,
      "text": "꼬라박은 돈이 얼만데",
      "kind": "line"
    },
    {
      "t": 2.48,
      "text": "어떻게 수능 등급이",
      "kind": "line"
    },
    {
      "t": 3.59,
      "text": "7 7 7등급이 나와요?",
      "kind": "line"
    },
    {
      "t": 5.21,
      "text": "잭팟이 터졌네요?",
      "kind": "line"
    },
    {
      "t": 6.44,
      "text": "지명아,",
      "kind": "line"
    },
    {
      "t": 7.01,
      "text": "네가 목표가 없어서 그래",
      "kind": "line"
    },
    {
      "t": 8.63,
      "text": "무슨 목표요?",
      "kind": "line"
    },
    {
      "t": 9.59,
      "text": "네가 원하는",
      "kind": "line"
    },
    {
      "t": 11.27,
      "text": "그런 것들 있잖아",
      "kind": "line"
    },
    {
      "t": 12.53,
      "text": "있는 거 같긴 한데",
      "kind": "line"
    },
    {
      "t": 13.82,
      "text": "지명이가 수능",
      "kind": "line"
    },
    {
      "t": 14.81,
      "text": "3등급 이상만 맞으면",
      "kind": "line"
    },
    {
      "t": 16.34,
      "text": "선생님이 소원 들어줄게",
      "kind": "line"
    },
    {
      "t": 17.99,
      "text": "소원이요?",
      "kind": "line"
    },
    {
      "t": 18.86,
      "text": "네가 원하는 거 다",
      "kind": "line"
    },
    {
      "t": 20.18,
      "text": "원하는 거 다요?",
      "kind": "line"
    },
    {
      "t": 21.71,
      "text": "응",
      "kind": "line"
    },
    {
      "t": 23.69,
      "text": "(열공 모드 돌입)",
      "kind": "line"
    },
    {
      "t": 23.94,
      "text": "오늘 숙제 다 풀었어요",
      "kind": "line"
    },
    {
      "t": 25.49,
      "text": "벌써?",
      "kind": "line"
    },
    {
      "t": 26.9,
      "text": "저는 벌을 받아야 돼요?",
      "kind": "line"
    },
    {
      "t": 28.79,
      "text": "다 맞았어 지명아",
      "kind": "line"
    },
    {
      "t": 30.29,
      "text": "봐! 하면 할 수 있잖아",
      "kind": "line"
    },
    {
      "t": 32.99,
      "text": "아 저도 할 수 있군요",
      "kind": "line"
    },
    {
      "t": 34.4,
      "text": "쌤님",
      "kind": "line"
    },
    {
      "t": 35.75,
      "text": "네?",
      "kind": "line"
    },
    {
      "t": 36.26,
      "text": "솔직히 지명이한테는",
      "kind": "line"
    },
    {
      "t": 37.76,
      "text": "답이 없어요",
      "kind": "line"
    },
    {
      "t": 39.74,
      "text": "하 게임 방송이라도",
      "kind": "line"
    },
