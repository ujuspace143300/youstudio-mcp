{
  // Cloudflare Workers 설정. 로컬은 `npx wrangler dev`, 배포는 `npx wrangler deploy`.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "youstudio-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // 스타일 문서(.md)를 텍스트로 import 한다 — script 단계가 나레이션.md 를 그대로 내려보낸다
  "rules": [{ "type": "Text", "globs": ["**/*.md"], "fallthrough": true }],
  // 발급 대장(이메일 허가제) — 배포 전 실제 KV 를 만들어 id 를 넣는다:
  //   npx wrangler kv namespace create LICENSES  → 나온 id 를 아래 "id" 에 채운다.
  //   KV 가 없으면(로컬 dev) 서버는 단일 토큰 폴백으로 돈다. 설계: 설계/인증_이메일허가제.md
  "kv_namespaces": [{ "binding": "LICENSES", "id": "72f8cc835e1548ca89f364f028d3f6ea" }]
}
