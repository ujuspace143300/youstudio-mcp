# ── 비밀 ─────────────────────────────────────────────────────────────────
# ★이 블록을 지우지 마라. 여기 걸린 파일이 한 번이라도 커밋되면 이력에 남아
#   파일을 지워도 회수되지 않는다.
.env
.env.*
!.env.example
*_key
.dev.vars

# ── 설치하면 다시 생기는 것 ──────────────────────────────────────────────
node_modules/
서버/node_modules/
.wrangler/
dist/

# ── 작업 산출물 (영상 만들 때 생김 · 크고 재생성 가능) ────────────────────
work/
**/work/
youstudio_work/
**/youstudio_work/
# 미디어·프레임·클립은 어디에 있든 저장소 밖 (작업 폴더는 저장소 밖 Desktop/youstudio_work 이 정본)
*.mp4
*.mkv
*.mov
*.wav
*.mp3
*.jpg
*.jpeg
*.png

# ── OS · 편집기 임시 파일 ────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
*.swp
*~
__pycache__/
*.pyc

# 분석 표본 — 영상·프레임은 저장소에 넣지 않는다 (내부 분석 전용, 재배포 금지)
분석/**/*.mp4
분석/**/*.mkv
분석/**/*.webm
분석/**/*.mov
분석/**/프레임/


# 도너 시험 사본 (왕복 시험용 — 재생성 가능). 도너_2판(크기 축소판)은 2026-08-20 폐기 — 본선은 원본 도너
도너/_도너시험*.prproj
도너/도너_2판.prproj
