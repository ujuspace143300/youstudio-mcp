# ── 비밀 ─────────────────────────────────────────────────────────────────
# ★이 블록을 지우지 마라. 여기 걸린 파일이 한 번이라도 커밋되면 이력에 남아
#   파일을 지워도 회수되지 않는다.
.env
.env.*
!.env.example
*_key
.dev.vars

# ── 설치하면 다시 생기는 것 ──────────────────────────────────────────────
node_modules/
서버/node_modules/
.wrangler/
dist/

# ── 작업 산출물 (영상 만들 때 생김 · 크고 재생성 가능) ────────────────────
work/
**/work/

# ── OS · 편집기 임시 파일 ────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
*.swp
*~
